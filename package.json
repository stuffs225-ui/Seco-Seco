{
  "name": "seco-seco",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "db:push": "supabase db push",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "db:local": "scripts/local-db/setup.sh",
    "db:local:test": "scripts/local-db/test.sh",
    "db:demo": "supabase db execute --file supabase/seeds/demo.sql",
    "db:local:demo": "sudo -u postgres psql -v ON_ERROR_STOP=1 -q -d seco_seco_dev -f supabase/seeds/demo.sql",
    "bootstrap:build": "node scripts/build-bootstrap.mjs",
    "bootstrap:check": "node scripts/build-bootstrap.mjs --check"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.8.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-table": "^9.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.114.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
