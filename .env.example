# ─────────────────────────────────────────────────────────────
# قالب متغيرات البيئة — انسخه إلى .env.local ولا ترفع .env.local للريبو
# ─────────────────────────────────────────────────────────────

# للتطوير المحلي: شغّل `npm run db:start` ثم خذ القيم من `npx supabase status`
# للإنتاج: تكامل Supabase في Vercel يحقن هذه القيم تلقائياً — لا تنسخها يدوياً
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ يتجاوز كل سياسات RLS. للمسارات الإدارية على الخادم فقط.
# لا تضف له بادئة NEXT_PUBLIC_ إطلاقاً — ذلك يسربه للمتصفح.
SUPABASE_SERVICE_ROLE_KEY=
